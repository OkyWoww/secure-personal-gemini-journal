import { Request, Response, NextFunction } from 'express';
export interface AuthenticatedRequest extends Request { user?: { uid: string, email?: string }; }
export const verifyAuth = async (req: AuthenticatedRequest, res: Response, next: NextFunction): Promise<void> => {
  const authHeader = req.headers.authorization;
  if (!authHeader || !authHeader.startsWith('Bearer ')) {
    res.status(401).json({ error: 'Unauthorized: Missing or invalid authorization header' }); return;
  }
  const idToken = authHeader.split('Bearer ')[1]?.trim();
  if (!idToken || idToken === 'null' || idToken === 'undefined') {
    res.status(401).json({ error: 'Unauthorized: Missing or invalid token string' }); return;
  }
  req.user = { uid: "mock-uid-123", email: "mock@example.com" };
  next();
};
